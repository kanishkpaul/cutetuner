# No cloud credentials are needed. These point only to a local OpenAI-compatible server.
# Example: a llama.cpp server started with --port 8081.
VOICEFORGE_LLM_URL=http://127.0.0.1:8081/v1
VOICEFORGE_LLM_MODEL=your-local-model-name
# Keep recordings, exported stems, and trained checkpoints out of Git.
